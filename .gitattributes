# 统一行尾：仓库内一律使用 LF，避免 Windows 上出现整文件 diff 噪声。
* text=auto eol=lf

# Windows 脚本保留 CRLF，方便 PowerShell / cmd 直接执行。
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换，也不参与文本 diff。
*.bin binary
*.elf binary
*.a binary
*.o binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.pdf binary
